{
  "compilerOptions": {
    "lib": ["es2023"],
    "module": "node20",
    "target": "es2023",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "types": ["node", "mocha"],
    "verbatimModuleSyntax": true
  },
  // `types/` holds the Typechain output regenerated by `hardhat compile`. It must be included:
  // its `hardhat.d.ts` is what teaches `ethers.deployContract("PedigreeRegistry")` to return a
  // typed contract instead of a bare BaseContract. Run `npx hardhat compile` before `tsc`.
  "include": [
    "hardhat.config.ts",
    "test/**/*.ts",
    "ignition/**/*.ts",
    "scripts/**/*.ts",
    "types/**/*.ts"
  ]
}
