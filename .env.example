# Copy to `.env` and fill in. Nothing here is needed to compile or to run the test suite — these
# values are read only when a command actually targets a public network.
#
# `.env` is gitignored. For anything beyond throwaway testnet keys prefer Hardhat's encrypted
# keystore, which never writes the secret to disk in the clear:
#   npx hardhat keystore set BASE_SEPOLIA_PRIVATE_KEY

# ── Base Sepolia (chain 84532) — the primary deployment target ─────────────────────────────

# Deployer private key, 0x-prefixed. Use an account that holds nothing but testnet funds.
BASE_SEPOLIA_PRIVATE_KEY=

# Optional. Defaults to the public endpoint https://sepolia.base.org, which is rate-limited but
# fine for a single deployment. Point this at Alchemy/QuickNode/your own node for anything heavier.
BASE_SEPOLIA_RPC_URL=

# ── Source verification ───────────────────────────────────────────────────────────────────

# Optional. An etherscan.io API key — the V2 API is multichain, so the same key verifies on
# Basescan. Leave it empty and verification falls back to Blockscout, which needs no key.
ETHERSCAN_API_KEY=

# ── Deployment parameters ─────────────────────────────────────────────────────────────────

# All optional; the defaults below are what the deploy script uses. One registry covers one
# species, so change these if you are not deploying the horse registry.
REGISTRY_NAME=
REGISTRY_SYMBOL=
REGISTRY_SPECIES=

# Address receiving DEFAULT_ADMIN_ROLE and BREED_ADMIN_ROLE. Defaults to the deployer. Those roles
# govern breed creation and the metadata base URI only — they confer no power over anyone's
# animals — but on a serious deployment they still belong to a multisig.
REGISTRY_ADMIN=

# ── Ethereum Sepolia (chain 11155111) — pre-existing, unused by the deploy script ──────────

SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=
