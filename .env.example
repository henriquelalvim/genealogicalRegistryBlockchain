# Copy to `.env` and fill in, or prefer Hardhat's encrypted keystore:
#   npx hardhat keystore set SEPOLIA_RPC_URL
#   npx hardhat keystore set SEPOLIA_PRIVATE_KEY
#
# Neither value is needed to compile or to run the test suite — they are only read when a
# command actually targets `--network sepolia`.

# JSON-RPC endpoint for the Sepolia testnet (Alchemy, Infura, a public node, ...).
SEPOLIA_RPC_URL=

# Deployer private key, 0x-prefixed.
# Use a throwaway account that holds nothing but testnet funds. Never put a key here that
# controls real value — this file's siblings are read by every tool in the toolchain.
SEPOLIA_PRIVATE_KEY=
