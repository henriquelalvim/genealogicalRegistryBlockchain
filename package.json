{
  "name": "genealogical-registry-blockchain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A proposed ERC standard for on-chain lineage registries: ERC-721 tokens forming a sexed genealogical DAG, with pedigree animals as the driving use case.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "typecheck": "hardhat compile && tsc --noEmit -p tsconfig.json",
    "clean": "hardhat clean",
    "node": "hardhat node",
    "deploy:local": "hardhat ignition deploy ignition/modules/PedigreeRegistry.ts --network localhost"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.8.5",
    "chai": "^6.2.2",
    "ethers": "^6.14.0",
    "hardhat": "^3.11.1",
    "mocha": "^11.0.0",
    "typescript": "~5.9.0"
  }
}
