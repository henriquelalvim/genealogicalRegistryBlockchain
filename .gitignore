# ── Node ──────────────────────────────────────────────────────────────────
node_modules/
dist/
*.log
npm-debug.log*

# ── Hardhat ───────────────────────────────────────────────────────────────
/artifacts
/cache
/types
/coverage
.gas-snapshot
/snapshots

# Ignition records real deployment addresses per chain. Local runs are throwaway;
# anything deployed to a public network is worth committing, so ignore only the
# in-memory/local chain IDs.
/ignition/deployments/chain-31337/

# ── Remix compiler artifacts (kept: the contracts are still editable in Remix) ──
**/artifacts/
**/artifacts/**

# Remix plugin state folders
deps/
states/

# ── Debug info ────────────────────────────────────────────────────────────
*.dbg.json
*.tsbuildinfo

# ── Secrets ───────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
